# ===========================================
# Elasticsearch Configuration (Optional)
# ===========================================
# Required only for vectorization tests that verify content_vector dimensions
# If not set, tests will verify vectorization via API metadata only

# Elasticsearch URL - supports two formats:
# 
# Format 1: Credentials embedded in URL (recommended for hosted Elasticsearch)
# DAGKNOWS_ELASTIC_URL=https://elastic:password@my-deployment.es.us-east-2.aws.elastic-cloud.com
#
# Format 2: Separate URL and credentials
# DAGKNOWS_ELASTIC_URL=https://my-deployment.es.us-east-2.aws.elastic-cloud.com
# DAGKNOWS_ELASTIC_USERNAME=elastic
# DAGKNOWS_ELASTIC_PASSWORD=your_password
#
# For local development:
# DAGKNOWS_ELASTIC_URL=http://elasticsearch:9200
# (or http://localhost:9200 if running locally)
#
# Example for hosted Elasticsearch (Elastic Cloud):
# ELASTIC_USER=elastic
# ELASTIC_PASSWORD=95EtxQPgPXk4vCMluk4ZZ1jK
# ELASTIC_HOST=my-deployment-05d0c4.es.us-east-2.aws.elastic-cloud.com
# DAGKNOWS_ELASTIC_URL=https://${ELASTIC_USER}:${ELASTIC_PASSWORD}@${ELASTIC_HOST}

# ===========================================
# Test Configuration
# ===========================================

# Test timeout (seconds)
TEST_TIMEOUT=30
PAGE_LOAD_TIMEOUT=30

# Test workspace
TEST_WORKSPACE=__DEFAULT__

# ===========================================
# Notes
# ===========================================
#
# 1. Getting JWT Token:
#    - Login to DagKnows via browser
#    - Open browser dev tools (F12)
#    - Go to Application/Storage → Local Storage
#    - Copy value of 'authToken' or similar
#    - OR check Authorization header in Network tab
#
# 2. For dev.dagknows.com:
#    - MUST include ?proxy=dev1 parameter
#    - DAGKNOWS_PROXY=?proxy=dev1
#    - Get JWT token from dev.dagknows.com
#
# 3. For LOCAL testing:
#    - DAGKNOWS_URL=http://localhost
#    - DAGKNOWS_PROXY=?proxy=yashlocal (REQUIRED!)
#    - Get JWT token from localhost (different from dev!)
#    - Make sure your local app is running:
#      cd app_docker_compose_build_deploy
#      docker-compose -f local-docker-c-backup-bfr-reorder.yml up -d
#
# 4. Test user should have:
#    - Admin or Supremo role
#    - Access to test workspace
#    - All required permissions
#
# 5. For the AI Agent workflow test:
#    - Use: yash+user@dagknows.com (or your test user)
#    - User should have access to "Default" workspace
#    - AI features should be enabled
#
# 6. For vectorization tests:
#    - Elasticsearch access is optional
#    - If DAGKNOWS_ELASTIC_URL is set, tests will verify vector dimensions
#    - If not set, tests will still verify vectorization via API metadata
#    - Tests will gracefully skip ES verification if ES is not accessible

